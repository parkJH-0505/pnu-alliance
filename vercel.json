{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path((?!api|assets).*)",
      "destination": "/index.html"
    }
  ]
}
